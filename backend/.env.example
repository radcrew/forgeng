# Copy to .env and adjust for your local PostgreSQL instance.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forgeng?schema=public"

# Port the NestJS API listens on (Next.js dev uses 3000).
PORT=3001

# Comma-separated list of origins allowed by CORS (the frontend).
CORS_ORIGIN="http://localhost:3000"

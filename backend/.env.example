# Copy to .env and adjust for your local PostgreSQL instance.
# Validated at startup via src/config/env.validation.ts

# development | production | test
NODE_ENV=development

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forgeng?schema=public"

# Port the NestJS API listens on (Next.js dev uses 3000).
PORT=3001

# Comma-separated list of origins allowed by CORS (the frontend).
CORS_ORIGIN="http://localhost:3000"

# Public base URL of the frontend, used to build absolute links in emails.
FRONTEND_URL="http://localhost:3000"

# Directory for user uploads (avatars). Defaults to <backend>/uploads.
# UPLOADS_DIR=

# --- Auth / JWT ---
# In development the app falls back to dummy secrets so it boots without these.
# Production refuses to start unless JWT_ACCESS_SECRET and JWT_REFRESH_SECRET are set.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_TTL="7d"

# Name of the cookie holding the refresh token.
REFRESH_COOKIE_NAME="forgeng_refresh"
# Optional cookie domain (leave unset for localhost).
REFRESH_COOKIE_DOMAIN=

# Name of the cookie holding the access token.
ACCESS_COOKIE_NAME="forgeng_access"

# How long an email verification token stays valid (minutes). Default 1440 (24h).
EMAIL_VERIFY_TTL_MINUTES=1440
# How long a password reset token stays valid (minutes). Default 60 (1h).
PASSWORD_RESET_TTL_MINUTES=60

# Frontend redirect targets used after OAuth / email verification / password reset.
OAUTH_SUCCESS_REDIRECT="http://localhost:3000/auth/callback"
OAUTH_FAILURE_REDIRECT="http://localhost:3000/login?error=oauth"
EMAIL_VERIFY_REDIRECT="http://localhost:3000/auth/verify-email"
PASSWORD_RESET_REDIRECT="http://localhost:3000/auth/reset-password"

# --- Google OAuth ---
# All three must be set to enable Google login (otherwise the provider is disabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# --- GitHub OAuth ---
# All three must be set to enable GitHub login (otherwise the provider is disabled).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL="http://localhost:3001/api/auth/github/callback"

# --- SMTP / email ---
# SMTP_HOST must be set to enable outbound email; otherwise email sending is disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" or "1" to use TLS.
SMTP_SECURE=false
EMAIL_FROM="no-reply@forgeng.local"

# --- Reverse proxy / trust ---
# Number of trusted reverse-proxy hops in front of this server (nginx, load
# balancer, etc.). Set to 1 for a single proxy, 2 for two hops, 0 for direct.
# When set, Express reads req.ip from X-Forwarded-For correctly and clients
# cannot spoof their IP by injecting a fake XFF header.
TRUST_PROXY=1

# --- IP reputation / region restriction ---
# IPQualityScore API key, used to detect VPNs/proxies and the visitor's country
# on register/login. Leave unset to skip the check entirely.
IPQUALITYSCORE_API_KEY=

// Prisma schema for Forgeng — cohort-based apprenticeship platform.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  applicant
  student
  admin
}

enum ApplicationStatus {
  pending
  accepted
  rejected
}

enum CohortStatus {
  draft
  active
  completed
}

enum TaskType {
  coding
  reading
  project
  quiz
}

enum TaskStatus {
  draft
  published
}

enum SubmissionStatus {
  submitted
  approved
  needs_work
}

enum Verdict {
  approved
  needs_work
}

enum AuthProvider {
  google
  github
}

enum VerificationTokenType {
  email_verify
  password_reset
}

enum NotificationType {
  feedback_received
  task_published
  submission_received
  application_received
  payment_eligible
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model User {
  id            Int      @id @default(autoincrement())
  // Optional external identity (e.g. Clerk). Nullable because users can sign up
  // with email/password or OAuth (see AuthIdentity).
  clerkId       String?  @unique @map("clerk_id")
  email         String   @unique
  // Null for OAuth-only users who never set a password.
  passwordHash  String?  @map("password_hash")
  emailVerified Boolean  @default(false) @map("email_verified")
  name          String?
  role          Role     @default(applicant)
  bio           String?
  githubUrl     String?  @map("github_url")
  avatarUrl            String?  @map("avatar_url")
  registrationIp       String?  @map("registration_ip")
  registrationCountry  String?  @map("registration_country")
  registrationCity     String?  @map("registration_city")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  enrollments    Enrollment[]
  submissions    Submission[]
  feedback       Feedback[]
  identities     AuthIdentity[]
  refreshTokens  RefreshToken[]
  verifyTokens   VerificationToken[]
  application    Application?
  notifications  Notification[]
  notificationPreference NotificationPreference?
  payments       Payment[]

  @@map("users")
}

model AuthIdentity {
  id                Int          @id @default(autoincrement())
  userId            Int          @map("user_id")
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  email             String?
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_identities")
}

model VerificationToken {
  id        Int                   @id @default(autoincrement())
  userId    Int                   @map("user_id")
  tokenHash String                @unique @map("token_hash")
  type      VerificationTokenType
  expiresAt DateTime              @map("expires_at") @db.Timestamptz
  usedAt    DateTime?             @map("used_at") @db.Timestamptz
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  // Hash of the token that replaced this one during rotation. Lets us detect
  // refresh-token reuse and revoke the whole family.
  replacedByHash String? @map("replaced_by_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Application {
  id           Int               @id @default(autoincrement())
  // The account that submitted this application. Nullable to preserve any
  // legacy anonymous rows; new applications are always tied to a user, and the
  // unique constraint enforces one application per account.
  userId       Int?              @unique @map("user_id")
  email        String
  firstName    String            @map("first_name")
  lastName     String            @map("last_name")
  status       ApplicationStatus @default(pending)
  motivation   String?
  background   String?
  experience   String?
  linkedin     String?
  twitter      String?
  facebook     String?
  github       String?
  portfolio    String?
  telegram     String?
  whatsapp     String?
  country      String?
  videoUrl     String?           @map("video_url")
  wallets      Json?
  reviewerNote String?           @map("reviewer_note")
  cohortId     Int?              @map("cohort_id")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@map("applications")
}

model Cohort {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  status      CohortStatus @default(draft)
  capacity    Int          @default(20)
  startDate   DateTime?    @map("start_date") @db.Timestamptz
  endDate     DateTime?    @map("end_date") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  applications Application[]
  enrollments  Enrollment[]
  tasks        Task[]

  @@map("cohorts")
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  cohortId   Int      @map("cohort_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@map("enrollments")
}

model Task {
  id          Int        @id @default(autoincrement())
  cohortId    Int        @map("cohort_id")
  title       String
  description String?
  type        TaskType   @default(coding)
  status      TaskStatus @default(draft)
  dueDate     DateTime?  @map("due_date") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  cohort      Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@map("tasks")
}

model Submission {
  id        Int              @id @default(autoincrement())
  taskId    Int              @map("task_id")
  userId    Int              @map("user_id")
  content   String?
  repoUrl   String?          @map("repo_url")
  status    SubmissionStatus @default(submitted)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  task     Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback Feedback[]

  @@map("submissions")
}

model Feedback {
  id           Int      @id @default(autoincrement())
  submissionId Int      @map("submission_id")
  reviewerId   Int      @map("reviewer_id")
  content      String
  verdict      Verdict
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User       @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType
  title     String
  body      String?
  // In-app deep link, e.g. /student/submissions or /student/tasks/:id.
  link      String?
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Payment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("USDT") @db.VarChar(20)
  txLink    String?  @map("tx_link") @db.VarChar(500)
  note      String?
  paidAt    DateTime @default(now()) @map("paid_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

// Singleton platform-wide configuration. There is always exactly one row (id=1).
model PlatformSetting {
  id              Int      @id @default(1)
  stipendMonth1   Decimal  @default(30)   @map("stipend_month_1") @db.Decimal(12, 2)
  stipendMonth2   Decimal  @default(50)   @map("stipend_month_2") @db.Decimal(12, 2)
  stipendMonth3   Decimal  @default(100)  @map("stipend_month_3") @db.Decimal(12, 2)
  stipendCurrency String   @default("USDT") @map("stipend_currency") @db.VarChar(20)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_settings")
}

// Per-student delivery settings, one row per user. A missing row means every
// channel is on (see the defaults below) — rows are created lazily on first edit.
model NotificationPreference {
  userId        Int      @id @map("user_id")
  feedbackInApp Boolean  @default(true) @map("feedback_in_app")
  feedbackEmail Boolean  @default(true) @map("feedback_email")
  taskInApp     Boolean  @default(true) @map("task_in_app")
  taskEmail     Boolean  @default(true) @map("task_email")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

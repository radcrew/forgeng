{
  "name": "forgeng",
  "version": "0.0.1",
  "private": true,
  "description": "forgeng monorepo — Next.js frontend + NestJS backend + PostgreSQL (Prisma)",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "dev:web": "pnpm --filter @forgeng/web dev",
    "dev:api": "pnpm --filter @forgeng/api dev",
    "prisma:generate": "pnpm --filter @forgeng/api prisma:generate",
    "prisma:migrate": "pnpm --filter @forgeng/api prisma:migrate",
    "prisma:studio": "pnpm --filter @forgeng/api prisma:studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.0"
  }
}

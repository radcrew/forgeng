# Copy to .env.local and adjust for your local backend instance.

# Base URL of the NestJS API (see ../backend). Locally the app calls the API
# directly. In a deployment where the app and API are on different domains, set
# this to "" instead: the client then requests relative /api/... paths, which
# next.config.ts rewrites to BACKEND_ORIGIN. That keeps the API same-origin so
# its cookies are readable by proxy.ts — cross-domain they never would be.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Rewrite target for /api/* when NEXT_PUBLIC_API_URL is "". Server-side only.
# BACKEND_ORIGIN="https://forgeng-backend.onrender.com"

# Public URL of this app, used to build absolute links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Must match the backend's JWT_ACCESS_SECRET exactly. The OAuth callback
# (src/app/auth/callback) and src/proxy.ts verify the access-token cookie
# locally instead of calling the API, so a mismatched or missing secret
# here makes Google/GitHub sign-in silently fail to redirect after login.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
